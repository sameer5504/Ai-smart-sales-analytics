# Backend environment variables example

JWT_SECRET_KEY=replace-with-a-secure-secret
FRONTEND_ORIGIN=http://localhost:5173

# false for local HTTP development.
# Set to true in production when using HTTPS.
REFRESH_COOKIE_SECURE=false

# Azure ML endpoint serving the AutoML forecasting model. Both must be set for it to
# be used; with either missing the API serves the model in backend/models instead.
AZURE_FORECAST_ENDPOINT=
AZURE_FORECAST_KEY=
